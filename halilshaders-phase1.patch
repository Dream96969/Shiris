diff --git a/common/src/main/resources/halilshaders/shaders/gbuffers_skybasic.fsh b/common/src/main/resources/halilshaders/shaders/gbuffers_skybasic.fsh
new file mode 100644
index 000000000..a7673412a
--- /dev/null
+++ b/common/src/main/resources/halilshaders/shaders/gbuffers_skybasic.fsh
@@ -0,0 +1,29 @@
+#version 330 compatibility
+
+/* DRAWBUFFERS:0 */
+
+uniform mat4 gbufferProjectionInverse;
+uniform vec3 fogColor;
+uniform vec3 skyColor;
+uniform vec3 upPosition;
+uniform float viewWidth;
+uniform float viewHeight;
+uniform int renderStage;
+
+in vec4 glcolor;
+
+void main() {
+	// Stars and the sunrise/sunset glow keep their vanilla vertex colors.
+	if (renderStage == MC_RENDER_STAGE_STARS || renderStage == MC_RENDER_STAGE_SUNSET) {
+		gl_FragData[0] = glcolor;
+		return;
+	}
+
+	// Sky dome: horizon fog color blending up into the sky color.
+	vec2 uv = gl_FragCoord.xy / vec2(viewWidth, viewHeight);
+	vec4 p = gbufferProjectionInverse * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
+	vec3 viewDir = normalize(p.xyz / p.w);
+	float height = dot(viewDir, normalize(upPosition));
+
+	gl_FragData[0] = vec4(mix(fogColor, skyColor, smoothstep(0.0, 0.45, height)), 1.0);
+}
