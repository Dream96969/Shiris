diff --git a/common/src/main/resources/halilshaders/shaders/composite.fsh b/common/src/main/resources/halilshaders/shaders/composite.fsh
new file mode 100644
index 000000000..1b936eb9f
--- /dev/null
+++ b/common/src/main/resources/halilshaders/shaders/composite.fsh
@@ -0,0 +1,37 @@
+#version 330 compatibility
+
+/* DRAWBUFFERS:0 */
+
+uniform sampler2D colortex0;
+uniform sampler2D depthtex0;
+uniform mat4 gbufferProjectionInverse;
+uniform vec3 fogColor;
+uniform float fogStart;
+uniform float fogEnd;
+uniform float far;
+
+in vec2 texcoord;
+
+void main() {
+	vec4 scene = texture(colortex0, texcoord);
+	float depth = texture(depthtex0, texcoord).r;
+
+	if (depth < 1.0) {
+		vec4 p = gbufferProjectionInverse * vec4(vec3(texcoord, depth) * 2.0 - 1.0, 1.0);
+		float dist = length(p.xyz / p.w);
+
+		// Environmental fog (haze, underwater, lava, blindness) as reported by the game.
+		float envFog = 0.0;
+		if (fogEnd > fogStart) {
+			envFog = clamp((dist - fogStart) / (fogEnd - fogStart), 0.0, 1.0);
+		}
+
+		// Render distance fog hides the edge of the loaded world.
+		float rdStart = far - clamp(far * 0.1, 4.0, 64.0);
+		float rdFog = clamp((dist - rdStart) / (far - rdStart), 0.0, 1.0);
+
+		scene.rgb = mix(scene.rgb, fogColor, max(envFog, rdFog));
+	}
+
+	gl_FragData[0] = scene;
+}
