diff --git a/common/src/main/resources/halilshaders/shaders/lib/gbuffer_deferred.glsl b/common/src/main/resources/halilshaders/shaders/lib/gbuffer_deferred.glsl
new file mode 100644
index 000000000..35c74e622
--- /dev/null
+++ b/common/src/main/resources/halilshaders/shaders/lib/gbuffer_deferred.glsl
@@ -0,0 +1,25 @@
+// Opaque geometry: write data for the deferred pass.
+//   colortex0 = albedo
+//   colortex1 = view-space normal (rgb), sky light level (a)
+//   colortex2 = vanilla lightmap color (rgb)
+uniform sampler2D gtexture;
+uniform sampler2D lightmap;
+uniform vec4 entityColor;
+
+in vec2 texcoord;
+in vec2 lmcoord;
+in vec4 glcolor;
+in vec3 viewNormal;
+
+void main() {
+	vec4 albedo = texture(gtexture, texcoord) * glcolor;
+	if (albedo.a < 0.1) discard;
+	albedo.rgb = mix(albedo.rgb, entityColor.rgb, entityColor.a);
+
+	// Raw lightmap coordinates span 1/32 .. 31/32; remap the sky channel to 0..1.
+	float skyLevel = clamp((lmcoord.y - 0.03125) * 1.0666667, 0.0, 1.0);
+
+	gl_FragData[0] = vec4(albedo.rgb, 1.0);
+	gl_FragData[1] = vec4(viewNormal * 0.5 + 0.5, skyLevel);
+	gl_FragData[2] = vec4(texture(lightmap, lmcoord).rgb, 1.0);
+}
diff --git a/common/src/main/resources/halilshaders/shaders/lib/gbuffer_forward_lit.glsl b/common/src/main/resources/halilshaders/shaders/lib/gbuffer_forward_lit.glsl
new file mode 100644
index 000000000..f040e5c3b
--- /dev/null
+++ b/common/src/main/resources/halilshaders/shaders/lib/gbuffer_forward_lit.glsl
@@ -0,0 +1,16 @@
+// Translucent geometry drawn after the deferred pass: lit here with the vanilla lightmap.
+uniform sampler2D gtexture;
+uniform sampler2D lightmap;
+uniform vec4 entityColor;
+
+in vec2 texcoord;
+in vec2 lmcoord;
+in vec4 glcolor;
+
+void main() {
+	vec4 color = texture(gtexture, texcoord) * glcolor;
+	if (color.a < 0.01) discard;
+	color.rgb = mix(color.rgb, entityColor.rgb, entityColor.a);
+	color.rgb *= texture(lightmap, lmcoord).rgb;
+	gl_FragData[0] = color;
+}
