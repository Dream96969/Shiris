diff --git a/common/src/main/resources/halilshaders/shaders/deferred.fsh b/common/src/main/resources/halilshaders/shaders/deferred.fsh
new file mode 100644
index 000000000..221c3ed54
--- /dev/null
+++ b/common/src/main/resources/halilshaders/shaders/deferred.fsh
@@ -0,0 +1,36 @@
+#version 330 compatibility
+
+/* DRAWBUFFERS:0 */
+
+uniform sampler2D colortex0;
+uniform sampler2D colortex1;
+uniform sampler2D colortex2;
+uniform sampler2D depthtex0;
+uniform vec3 shadowLightPosition;
+uniform float rainStrength;
+
+in vec2 texcoord;
+
+// How much surfaces facing the sun (or moon at night) are brightened.
+const float LIGHT_STRENGTH = 0.25;
+
+void main() {
+	vec4 scene = texture(colortex0, texcoord);
+
+	// Sky pixels have no geometry to light.
+	if (texture(depthtex0, texcoord).r >= 1.0) {
+		gl_FragData[0] = scene;
+		return;
+	}
+
+	vec4 normalData = texture(colortex1, texcoord);
+	vec3 normal = normalize(normalData.rgb * 2.0 - 1.0);
+	float skyLevel = normalData.a;
+	vec3 lightmapColor = texture(colortex2, texcoord).rgb;
+
+	// Only surfaces that can see the sky get the directional term.
+	float facing = max(dot(normal, normalize(shadowLightPosition)), 0.0);
+	float direct = facing * skyLevel * skyLevel * (1.0 - 0.8 * rainStrength);
+
+	gl_FragData[0] = vec4(scene.rgb * lightmapColor * (1.0 + LIGHT_STRENGTH * direct), scene.a);
+}
