--- /dev/null
+++ b/common/src/main/resources/halilshaders/shaders/lib/gbuffers_vertex.glsl
@@ -0,0 +1,16 @@
+// Shared vertex stage for every gbuffers_* program.
+out vec2 texcoord;
+out vec2 lmcoord;
+out vec4 glcolor;
+out vec3 viewNormal;
+
+void main() {
+	gl_Position = ftransform();
+	texcoord = (gl_TextureMatrix[0] * gl_MultiTexCoord0).xy;
+	// Raw lightmap coordinates: usable directly to sample the vanilla lightmap texture.
+	lmcoord = (gl_TextureMatrix[1] * gl_MultiTexCoord1).xy;
+	glcolor = gl_Color;
+
+	vec3 n = gl_NormalMatrix * gl_Normal;
+	viewNormal = dot(n, n) > 0.0001 ? normalize(n) : vec3(0.0, 0.0, 1.0);
+}
