{
  "schemaVersion": 1,
  "id": "shiris",
  "version": "${version}",
  "name": "Shiris",
  "description": "A Fabric shader mod for Minecraft with a built-in, performance-focused shader",
  "authors": [
    "Iris fork - Dream96969"
  ],
  "contact": {
    "homepage": "https://github.com/Dream96969/Shiris",
    "sources": "https://github.com/Dream96969/Shiris",
    "issues": "https://github.com/Dream96969/Shiris/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/iris/textures/gui/iris-logo.png",
  "environment": "client",
  "mixins": [
    "mixins.iris.json",
    "mixins.iris.fabric.json",
    "mixins.iris.fantastic.json",
    "mixins.iris.vertexformat.json",
    "mixins.iris.bettermipmaps.json",
    "mixins.iris.compat.sodium.json",
    "mixins.iris.compat.dh.json",
    "mixins.iris.fixes.maxfpscrash.json"
  ],
  "accessWidener": "iris.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.1",

    "sodium": [
      "0.8.x"
    ]
  },
  "breaks": {
    "embeddium": "*",
    "iris-explorer": "*",
    "originsenhanced": "<=1.3.2",
    "colormatic": "<=3.0.0",
    "bedrockwaters": "<=1.6.0",
    "batchedentityrendering": "*",
    "canvas": "*",
    "optifabric": "*",
    "worldeditcui": "<1.18.1",
    "physicsmod": "<=3.0.13",
    "distanthorizons": "<=2.1.99",
    "immersive_portals": "<=1.4.2"
  },
  "custom": {
    "sodium:options": {
      "mixin.features.render.world.sky": false
    },
    "mc-publish": {
      "loaders": [
        "fabric",
        "quilt"
      ]
    },
    "loom:injected_interfaces": {
      "net/minecraft/class_276": ["net/irisshaders/iris/mixinterface/RenderTargetInterface"],
      "com/mojang/blaze3d/textures/GpuTexture": ["net/irisshaders/iris/mixinterface/GpuTextureInterface"],
      "com/mojang/blaze3d/systems/RenderPass": ["net/irisshaders/iris/mixinterface/RenderPassInterface"],
      "net/minecraft/class_1921": ["net/irisshaders/iris/mixinterface/RenderTypeInterface"],
      "net/minecraft/class_759": ["net/irisshaders/iris/mixinterface/ItemInHandInterface"]
    }
  }
}
